<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Putar" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0D0F14</item>
        <item name="android:statusBarColor">#0D0F14</item>
        <item name="android:navigationBarColor">#0D0F14</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- tema splash (coral + not musik) yang menutup ke tema utama -->
    <style name="Theme.Putar.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF5A36</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_stat_music</item>
        <item name="postSplashScreenTheme">@style/Theme.Putar</item>
        <item name="android:windowBackground">#0D0F14</item>
    </style>
</resources>
